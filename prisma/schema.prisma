generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DELIVERY_PARTNER
  ADMIN
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  phoneNumber   String?         @unique
  emailVerified Boolean         @default(false)
  image         String?
  role          Role            @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  payoutAccounts PayoutAccount[]
  addresses     Address[]
  reviewsGiven  Review[]        @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  customerOrders Order[]        @relation("CustomerOrders")
  deliveryOrders Order[]        @relation("DeliveryPartnerOrders")

  isAvailableForDelivery Boolean        @default(false)
  currentLatitude        Float?
  currentLongitude       Float?
  lastLocationUpdatedAt  DateTime?
  postedRequests         GroceryRequest[] @relation("PosterRequests")
  shopperRequests        GroceryRequest[] @relation("ShopperRequests")
  targetShopperRequests  GroceryRequest[] @relation("TargetShopperRequests")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

enum PayoutAccountType {
  BANK
  MOBILE_MONEY
}

model PayoutAccount {
  id            String            @id @default(cuid())
  userId        String
  accountType   PayoutAccountType
  provider      String            // e.g. Telebirr, CBE, Awash Bank
  accountName   String
  accountNumber String
  isPrimary     Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_account")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   // e.g. Home, Work
  street     String
  city       String
  state      String?
  postalCode String?
  country    String   @default("Ethiopia")
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  revieweeId  String
  orderId     String?
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("review")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  customerId        String
  deliveryPartnerId String?
  status            OrderStatus @default(PENDING)
  title             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  deliveryPartner   User?       @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  @@map("order")
}

enum RequestStatus {
  OPEN
  DIRECT_PENDING
  ACCEPTED
  SHOPPING
  OVER_BUDGET_PENDING
  SHOPPING_COMPLETED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OverBudgetResolution {
  APPROVED_INCREASE
  INSTRUCTED_REMOVE_ITEMS
  AUTO_TIMEOUT_DEFAULT
}

model GroceryRequest {
  id                    String                @id @default(cuid())
  posterId              String
  shopperId             String?
  targetShopperId       String?

  // Budget & Fees (FR-14)
  budgetCeiling         Float
  originalBudgetCeiling Float
  deliveryFee           Float
  actualSpent           Float?
  receiptUrl            String?

  // Location & Schedule (FR-14)
  deliveryAddress       String
  deliveryLatitude      Float
  deliveryLongitude     Float
  deadline              DateTime?

  // Lifecycle & State (FR-18)
  status                RequestStatus         @default(OPEN)
  directRequestExpiresAt DateTime?
  deliveredAt           DateTime?
  autoDeliveryConfirmAt DateTime?

  // Over-budget Handling (FR-19, FR-20)
  proposedOverBudgetAmount Float?
  overBudgetReason      String?
  overBudgetExpiresAt   DateTime?
  overBudgetResolution  OverBudgetResolution?

  // Cancellation & Disputes (FR-23, FR-24)
  cancellationReason    String?
  cancelledById         String?
  cancelledAt           DateTime?
  isDisputed            Boolean               @default(false)
  disputeReason         String?
  disputedById          String?
  disputedAt            DateTime?
  escrowFrozen          Boolean               @default(false)

  // Items and logs
  items                 GroceryItem[]
  statusLogs            RequestStatusLog[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  poster                User                  @relation("PosterRequests", fields: [posterId], references: [id], onDelete: Cascade)
  shopper               User?                 @relation("ShopperRequests", fields: [shopperId], references: [id], onDelete: SetNull)
  targetShopper         User?                 @relation("TargetShopperRequests", fields: [targetShopperId], references: [id], onDelete: SetNull)

  @@map("grocery_request")
}

model GroceryItem {
  id             String         @id @default(cuid())
  requestId      String
  name           String
  quantity       Int            @default(1)
  unit           String?
  estimatedPrice Float?
  notes          String?
  isRemoved      Boolean        @default(false)
  groceryRequest GroceryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("grocery_item")
}

model RequestStatusLog {
  id          String         @id @default(cuid())
  requestId   String
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById String?
  note        String?
  createdAt   DateTime       @default(now())
  request     GroceryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_status_log")
}


